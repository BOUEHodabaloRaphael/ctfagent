__pycache__/
*.pyc
.claude/settings.json

# Per-CTF secrets (session cookies, credentials) -- never commit these.
.env
workspaces/*/.env
workspaces/*/session/
src/tools/ctf/nctf26_storage_state.json
src/tools/ctf/.env

# Local run artifacts, not source.
logs/
*.pid
*.out
flags/pending/

# Full upstream clones kept locally for analysis only; too large / not ours to version.
targets/expressvpn-lightway/lightway/
targets/expressvpn-lightway/wolfssl-rs/

# NCTF finale harvest — untrusted downloaded PDFs/binaries/cloned repos, keep out of git
workspaces/**/downloads/
workspaces/nctf26-finale/telegram-harvest/pdfs/
workspaces/nctf26-finale/**/*.bak-*
# WhatsApp harvests — untrusted received files + extracted archives (incl. malware bins)
workspaces/nctf26-finale/*-whatsapp-*/incoming/
workspaces/nctf26-finale/*-whatsapp-*/zip-extract/

# KoTH finale toolkit — pre-staged exploit binaries (large, untrusted, not ours) + runtime/secrets
src/tools/ctf/koth_finale/privesc-arsenal/
src/tools/ctf/koth_finale/hill.env
src/tools/ctf/koth_finale/koth.log
src/tools/ctf/koth_finale/recon_*.txt
