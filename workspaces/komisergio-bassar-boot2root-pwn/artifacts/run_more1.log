#!/bin/sh
# nctf-entrypoint.sh — généré par creators-sync : pose le flag PAR ÉQUIPE puis lance l'appli.
# FLAG vient de l'instancier (prod). Hors arène (Lot-5), dérivé de TEAM_SECRET via openssl.
F="${FLAG:-}"
if [ -z "$F" ] && [ -n "${TEAM_SECRET:-}" ] && command -v openssl >/dev/null 2>&1; then
  H=$(printf %s "boot2root-komisergio--bassar" | openssl dgst -sha256 -hmac "$TEAM_SECRET" 2>/dev/null | sed 's/^.* //')
  [ -n "$H" ] && F="NCTF{$(printf %s "$H" | cut -c1-24)}"
fi
export FLAG="$F"
exec /start.sh
$ 
