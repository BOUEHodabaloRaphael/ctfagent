opt jail compile/run: #!/bin/sh
# Build: no PIE, no stack canary, executable stack
gcc -fno-stack-protector -z execstack -no-pie -O0 -o jail jail.c
#!/bin/sh
exec /opt/jail/jail
$ 
start.sh: #!/bin/bash
set -e

# --- users -------------------------------------------------------------
id frank >/dev/null 2>&1 || useradd -m -s /bin/bash frank
id adm   >/dev/null 2>&1 || useradd -m -s /bin/bash -g adm adm
echo 'frank:frank' | chpasswd

# --- sudo rules (the intended privesc ladder) -------------------------
cat > /etc/sudoers.d/10-nobody <<'SUD'
nobody ALL=(frank) NOPASSWD: /usr/bin/less /var/log/syslog
SUD
cat > /etc/sudoers.d/11-frank <<'SUD'
frank ALL=(adm) NOPASSWD: /usr/bin/vim /var/www/html/jailuser/dev/jail.c
SUD
chmod 440 /etc/sudoers.d/10-nobody /etc/sudoers.d/11-frank

# --- jail source + binary published (web and anonymous FTP) -----------
mkdir -p /var/www/html/jailuser/dev /srv/ftp
cp /opt/jail/jail.c /opt/jail/compile.sh /opt/jail/jail /var/www/html/jailuser/dev/
cp /opt/jail/jail.c /srv/ftp/jail.c
cat > /srv/ftp/README.txt <<'TXT'
Bassar forge - dev drop
build: ./compile.sh
service: nc bassar.local 9999
TXT
cat > /var/www/html/index.html <<'TXT'
<h1>Forge de Bassar</h1>
<p>Espace de developpement : <a href="/jailuser/dev/">/jailuser/dev/</a></p>
TXT

# --- flag --------------------------------------------------------------
if [ -z "${FLAG:-}" ]; then echo "FLAG manquant (injecte par l'instancier)" >&2; exit 1; fi
echo "$FLAG" > /root/root.txt
chmod 600 /root/root.txt
unset FLAG CHALLENGE_SECRET TEAM_SECRET  # NCTF26 : jamais herite par les services (foothold != root)

# --- root SSH access (key only) ---------------------------------------
mkdir -p /root/.ssh
cp /opt/keys/root_authorized.pub /root/.ssh/authorized_keys
chmod 700 /root/.ssh && chmod 600 /root/.ssh/authorized_keys
cat > /etc/ssh/sshd_config.d/90-lab.conf <<'SSH'
Port 22
PermitRootLogin prohibit-password
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
SSH
ssh-keygen -A >/dev/null

# --- adm vault ---------------------------------------------------------
mkdir -p /var/adm/.keys
cp /opt/keys/keys.zip /var/adm/.keys/keys.zip
cat > /var/adm/.keys/note.txt <<'NOTE'
Politique du coffre :
  mot de passe = Nom + 4 chiffres + 1 symbole
Le nom est cache dans .frank (Atbash).
NOTE
printf '%s\n' 'Vhxzkvw uiln Zoxzgizz' > /var/adm/.keys/.frank   # Atbash placeholder
chown -R adm:adm /var/adm/.keys
chmod 700 /var/adm/.keys
chmod 600 /var/adm/.keys/*

# --- services ----------------------------------------------------------
mkdir -p /var/run/vsftpd/empty
cat > /etc/vsftpd.conf <<'FTP'
listen=YES
listen_port=21
anonymous_enable=YES
anon_root=/srv/ftp
local_enable=NO
write_enable=NO
secure_chroot_dir=/var/run/vsftpd/empty
pam_service_name=vsftpd
FTP
mkdir -p /var/log
echo 'bassar forge syslog' > /var/log/syslog
chmod 644 /var/log/syslog
service ssh start
service apache2 start
$ 
