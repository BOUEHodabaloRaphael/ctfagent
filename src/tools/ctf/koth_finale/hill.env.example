# =====================================================================
# KoTH finale — config de la colline.  À REMPLIR À L'OUVERTURE (t+0).
# L'agent lance recon_koth.py, puis renseigne les 3 lignes marquées  <<<.
# Toi, tu lances ensuite UNE commande :  bash koth_run.sh start
# =====================================================================

# ---------------------------------------------------------------- colline
export KOTH_BASE="https://arena.ctf.tg"
export KOTH_CLAIM_PATH=""            # <<< ex: /plugins/koth/api/claim
export KOTH_CLAIM_METHOD="POST"      # POST | GET
export KOTH_CLAIM_BODY=""            # ex: {"hill":"1","team":"{token}"}
                                     # placeholders : {token} {team} {ts} {sig}
export KOTH_STATUS_PATH=""           # <<< ex: /plugins/koth/api/status
export KOTH_KING_FIELD="king"        # champ du roi ; dot-path ok (data.king)
export KOTH_OUR_ID=""                # <<< notre id d'equipe (virgules si plusieurs)

# ---------------------------------------------------------------- auth
# Par défaut : cookies de session lus dans ../nctf26_storage_state.json
export KOTH_TOKEN=""                 # jeton d'equipe (substitué dans le body)
export KOTH_AUTH=""                  # ex: "Bearer xxxxx"
export KOTH_HEADERS=""               # JSON d'en-têtes additionnels
export KOTH_STORAGE=""               # chemin storage_state (vide = défaut)
# export KOTH_TLS_INSECURE="1"       # si la colline a un certificat self-signed
# export KOTH_PROXY=""               # ex: http://127.0.0.1:8080

# =====================================================================
#  CADENCE — le coeur de l'endurcissement.  Valeurs par défaut = bonnes.
# =====================================================================
# Le scorer ne retient que le roi AU TICK : tout est calé pour que le
# DERNIER claim tombe quelques millisecondes avant ce tick.
export KOTH_SLOT_PERIOD="0"          # période du tick du scorer en s (0 = continu)
                                     # -> mets 60 si le score bouge chaque minute
export KOTH_SNIPE_WINDOW="1.5"       # largeur de la fenêtre de préparation
export KOTH_SNIPE_GRACE="0.25"       # on continue un peu après le tick
export KOTH_TRAIN_MAX="0.8"          # durée max du train final (s)
export KOTH_BASELINE_GAP="1.0"       # 1 claim/s hors fenêtre (phase du scorer inconnue)

# Niveaux d'endurcissement : on monte SEULEMENT si on perd plusieurs ticks d'affilée
export KOTH_THREADS_BASE="2"         # connexions au niveau 0
export KOTH_THREADS_MAX="8"          # plafond de connexions (anti-DoS)
export KOTH_INTERVAL_BASE="2.0"      # s entre deux claims hors fenêtre
export KOTH_INTERVAL_MIN="0.5"       # plancher absolu
export KOTH_MAX_LEVEL="2"            # 0..3 : 2 = 8 threads au maximum
export KOTH_LOSS_STREAK="2"          # pertes consécutives avant d'escalader
export KOTH_HOLD_TICKS="3"           # ticks gagnés avant de redescendre
export KOTH_RELAX_AFTER="20"         # s de tenue minimum avant de redescendre
export KOTH_BURST="4"                # claims immédiats après une perte
export KOTH_THROTTLE_SOFT="5"        # 429 en 10 s -> on ralentit un peu (jamais muet)

# =====================================================================
#  MULTI-MACHINES — toi + coéquipiers sur la même colline
# =====================================================================
# Mets le nombre TOTAL de machines qui tiennent la colline. Le débit de chaque
# machine est divisé par ce nombre : le total reste borné, et N machines
# tiennent mieux qu'une (plus de connexions parallèles = plus de claims dans
# la dernière milliseconde avant le tick).
export KOTH_PUMPS="1"                # <<< ex: 3 si vous êtes 3 machines
# export KOTH_PUMP_ID="kali1"        # vide = déduit du hostname

# ---------------------------------------------------------------- divers
export KOTH_PERIOD="5"               # rafraîchissement du status (obsolète)
export KOTH_STATUS_EVERY="5"         # idem (nouveau nom)
export KOTH_TIMEOUT="15"
export KOTH_UNTIL=""                 # ex: 2026-11-19T23:00:00Z (clôture annoncée)

# Claims signés (si la colline l'exige, comme "The Throne" au préqual)
# export KOTH_SIGN_KEY="<cle>"
# export KOTH_SIGN_ALGO="hmac-sha1"  # hmac-sha1 | hmac-sha256
# body : '{"team":"{token}","ts":{ts},"sig":"{sig}"}'   sig = HMAC(key, "team|ts")

# =====================================================================
#  MODE LOCAL — si tu as déjà un shell SUR la box (score = fichier "king")
# =====================================================================
# Renseigne KING_FILE et le moteur maintient le fichier lui-même.
# export KOTH_KING_FILE="/koth/king"
# export KOTH_KING_FILE2="/king/king.txt"
# export KOTH_REPAIR_INTERVAL="0.5"
# export KOTH_TOKEN="<notre jeton>"

# =====================================================================
#  MODE SSH — prise d'une colline machine (koth_ssh_takeover.sh)
# =====================================================================
# export KOTH_SSH_HOST="10.x.x.x"
# export KOTH_SSH_PORT="22"
# export KOTH_SSH_USER="player"
# export KOTH_SSH_PASS=""            # vide = clé SSH ; sinon sshpass
# export KING_FILE="/koth/king"
# export KOTH_REASSERT_PERIOD="20"
