# ===================================================================
# KoTH finale — config de la colline. À REMPLIR À L'OUVERTURE (t+0).
# L'agent recon la vraie colline (recon_koth.py) puis copie ce fichier
# en  hill.env  et renseigne les valeurs. Toi, tu lances juste run_hold.sh.
# ===================================================================

# Host de la plateforme / colline
export KOTH_BASE="https://arena.ctf.tg"

# --- Requête de CLAIM (prendre/garder la colline) ---
export KOTH_CLAIM_PATH=""          # ex: /plugins/koth/api/claim   <-- À CONFIRMER
export KOTH_CLAIM_METHOD="POST"    # POST | GET
export KOTH_CLAIM_BODY=""          # ex: {"hill":"1"}  ({token} sera substitué si présent)

# --- Requête de STATUS (suis-je roi ?) ---
export KOTH_STATUS_PATH=""         # ex: /plugins/koth/api/status  <-- À CONFIRMER
export KOTH_KING_FIELD="king"      # champ du JSON status = équipe/roi courant
export KOTH_OUR_ID=""              # notre identifiant d'équipe (pour comparer au roi)

# --- Auth ---
# Par défaut on réutilise les cookies de session (../nctf26_storage_state.json).
# Si la colline veut un token/bearer à la place, le mettre ici :
export KOTH_TOKEN=""               # jeton d'équipe si l'API le demande dans le body
export KOTH_AUTH=""                # ex: "Bearer xxxxx"  (laisser vide si cookies suffisent)

# --- Débit / cadence ---
export KOTH_THREADS="12"           # pompes parallèles (monter si un bot adverse résiste)
export KOTH_PERIOD="3"             # intervalle d'affichage du statut (s)
export KOTH_TIMEOUT="15"
