# ===================================================================
# KoTH finale — config de la colline. À REMPLIR À L'OUVERTURE (t+0).
# L'agent recon la vraie colline (recon_koth.py) puis copie ce fichier
# en  hill.env  et renseigne les valeurs. Toi, tu lances juste :
#     bash koth_hold.sh start
# ===================================================================

# --- Plateforme / colline ---
export KOTH_BASE="https://arena.ctf.tg"

# --- Requête de CLAIM (prendre/garder la colline) ---
export KOTH_CLAIM_PATH=""          # ex: /plugins/koth/api/claim   <-- À CONFIRMER
export KOTH_CLAIM_METHOD="POST"    # POST | GET
export KOTH_CLAIM_BODY=""          # ex: {"hill":"1","team":"{token}"}
                                   # placeholders : {token} {team} {ts} {sig}
# --- Requête de STATUS (suis-je roi ?) ---
export KOTH_STATUS_PATH=""         # ex: /plugins/koth/api/status  <-- À CONFIRMER
export KOTH_KING_FIELD="king"      # chemin du champ roi, dot-path accepté (data.king)
export KOTH_OUR_ID=""              # notre id/équipe (liste séparée par des virgules ok)

# --- Auth ---
# Par défaut : cookies de session depuis ../nctf26_storage_state.json.
export KOTH_TOKEN=""               # jeton d'équipe (substitué dans le body)
export KOTH_AUTH=""                # ex: "Bearer xxxxx" si la colline veut un header
export KOTH_HEADERS=""             # JSON d'en-têtes additionnels
export KOTH_STORAGE=""             # chemin storage_state (vide = défaut)

# --- Cadence (anti-DoS : ne pas matraquer) ---
export KOTH_THREADS="4"            # pompes parallèles (monter si un bot adverse résiste)
export KOTH_MIN_INTERVAL="1.0"     # secondes minimum entre 2 claims d'un même thread
export KOTH_SLOT_PERIOD="0"        # >0 = viser les ticks du scorer (ex: 60 si tick=1min)
export KOTH_SLOT_MARGIN="0.4"      # arriver un peu avant le tick
export KOTH_PERIOD="5"             # rafraîchissement du status / de status.json
export KOTH_TIMEOUT="15"

# --- Claims signés (si la colline l'exige, comme "The Throne" au préqual) ---
# export KOTH_SIGN_KEY="<cle>"
# export KOTH_SIGN_ALGO="hmac-sha1"     # hmac-sha1 | hmac-sha256
# body : '{"team":"{token}","ts":{ts},"sig":"{sig}"}'   (sig = HMAC(key,"team|ts"))

# --- Fin de partie (arrêt automatique) ---
export KOTH_UNTIL=""               # ex: 2026-11-19T23:00:00Z (heure de clôture annoncée)

# ===================================================================
# Colline SSH (score = fichier "king" sur la box) : koth_ssh_takeover.sh
# ===================================================================
export KOTH_SSH_HOST=""            # IP de la colline (via Mes instances / page KOTH)
export KOTH_SSH_PORT="22"
export KOTH_SSH_USER="player"
export KOTH_SSH_PASS=""            # vide = clé SSH ; sinon sshpass
export KING_FILE="/koth/king"      # fichier roi lu par le scorer
export KING_FILE2=""               # second emplacement éventuel (/king/king.txt)
export KOTH_REASSERT_PERIOD="20"   # re-pose la persistance toutes les N s (survit aux resets)
